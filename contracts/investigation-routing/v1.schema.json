{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitepilot.local/contracts/investigation-routing/v1.schema.json",
  "title": "InvestigationRoutingDecisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "task_id", "graph_revision", "policy_version",
    "provider", "model_version", "input_digest", "primary_intent", "primary_confidence",
    "intent_probabilities", "capabilities", "human_probability", "unknown_probability",
    "urgency_score", "route_disposition", "reason_codes", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "graph_revision": {"type": "integer", "minimum": 0},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "provider": {"type": "string", "enum": ["deterministic", "jev", "fallback"]},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "input_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "primary_intent": {"type": "string", "minLength": 1, "maxLength": 120},
    "primary_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "intent_probabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "probability", "disposition", "supporting_fact_refs"],
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "identity_resolution", "certificate_verification", "permit_validation",
              "equipment_observation", "equipment_diagnosis", "network_diagnosis",
              "maintenance_lookup", "evidence_validation", "regulation_retrieval",
              "remediation_validation", "current_observation", "plan_verification",
              "conclusion_verification", "closure_verification", "human_clarification"
            ]
          },
          "probability": {"type": "number", "minimum": 0, "maximum": 1},
          "disposition": {"type": "string", "enum": ["REQUIRED", "OPTIONAL_IF_BUDGET", "SKIP"]},
          "supporting_fact_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "human_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "unknown_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "urgency_score": {"type": "number", "minimum": 0, "maximum": 3},
    "route_disposition": {
      "type": "string",
      "enum": ["AUTO_ROUTE", "COLLECT_EVIDENCE", "HUMAN_CLARIFICATION", "HUMAN_ESCALATION"]
    },
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
