{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "task_id",
    "action_type",
    "level",
    "reason",
    "evidence_refs",
    "requires_approval",
    "verification_criteria",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "action_type": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 5
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requires_approval": {
      "type": "boolean"
    },
    "verification_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "minItems": 1
    },
    "verification_window_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    }
  }
}
